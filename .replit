modules = ["c-clang14"]
[agent]
expertMode = true

[nix]
channel = "stable-25_05"
packages = ["raylib", "xorg.libX11", "xorg.libXrandr", "xorg.libXinerama", "xorg.libXcursor", "xorg.libXi", "mesa", "libGL", "pkg-config", "glfw", "mesa_glu"]

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Jogo 007"

[[workflows.workflow]]
name = "Jogo 007"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "make run"

[workflows.workflow.metadata]
outputType = "vnc"
